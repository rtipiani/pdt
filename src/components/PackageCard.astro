---
const { title, duration, image, link, i18n } = Astro.props;

const pathname = Astro.url.pathname;
const currentLocale = pathname.startsWith('/en') ? 'en' : 'es';

const baseUrl = currentLocale === 'en'
  ? `https://pdtperuviantravel.com.pe/en/${link}`
  : `https://pdtperuviantravel.com.pe/${link}`;

const message = currentLocale === 'en'
  ? `Hello, I'm interested in the ${title} (${duration}) package. Could you give me more information?`
  : `Hola, estoy interesado en el paquete ${title} (${duration}). ¿Podrías brindarme más información?`;

const encodedMessage = encodeURIComponent(message);
const whatsappLink = `https://wa.me/51980852997?text=${encodedMessage}`;
---
<div class="bg-gray-50 bg-opacity-70 rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 px-6 py-6">
    <img src={image} alt={`Imagen del paquete ${title}`} width="400" height="192" class="w-full h-48 object-cover rounded-xl mb-6" loading="lazy" />
  
    <div class="mb-4">
        <h3 class="text-gray-800 text-xl font-semibold leading-snug">
            <a href={link} class="block">
                {title}
            </a>
        </h3>
        <div class="flex items-center gap-2 mt-1">
            <span class="bg-red-700 text-white text-sm font-semibold px-5 py-1 rounded-full shadow-sm">
                {duration}
            </span>
        </div>
    </div>

    <hr class="border-orange-300 mb-6" />

    <a href={whatsappLink} target="_blank" rel="noopener" aria-label={`Consultar paquete turístico: ${title} ${duration}`} class="flex items-center justify-between group">
        <span class="text-base font-semibold text-gray-900 group-hover:text-red-700 transition-colors">
            {i18n.consultNow}
        </span>
        <span class="w-9 h-9 bg-gray-900 text-white rounded-full flex items-center justify-center group-hover:bg-red-700 transition-colors">
            <i class="fa-brands fa-whatsapp"></i>
        </span>
    </a>
</div>