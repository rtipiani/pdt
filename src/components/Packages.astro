---
const { packagesSection } = Astro.props;
interface Package {
    title: string;
    image: string;
    link: string;
    whatsapp: string;
}
---
<section class="bg-white my-14">
    <div class="max-w-7xl mx-auto px-4">
        <div class="mb-8 text-center">
            <h3 class="text-4xl font-bold mb-4 text-gray-950">{packagesSection.title}</h3>
            <p class="text-gray-950" set:html={packagesSection.description} />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {packagesSection.packages.map((pkg: Package) => (
                <div class="bg-gray-50 bg-opacity-65 rounded-md px-6 py-4">
                    <img 
                        src={pkg.image} 
                        srcset={`${pkg.image.replace('.avif', '-400w.avif')} 400w, ${pkg.image.replace('.avif', '-800w.avif')} 800w`}
                        sizes="(max-width: 640px) 400px, 800px"
                        alt={pkg.title} 
                        width="400" 
                        height="176" 
                        class="object-cover rounded-lg w-full h-44" 
                        loading="lazy" 
                        decoding="async"
                    />
                    <div class="pt-8 pb-4">
                        <a href={pkg.link} class="block text-xl text-gray-950 font-bold h-14 hover:text-orange-600 transition-colors">
                            {pkg.title}
                        </a>
                    </div>
                    <div class="border border-red-700 my-4"></div>
                    <a href={pkg.whatsapp} class="flex justify-between items-center group" target="_blank">
                        <p class="text-red-700 font-bold group-hover:text-red-800 transition-colors">
                            {packagesSection.consultText}
                        </p>
                        <span class="w-8 h-8 flex items-center justify-center bg-red-700 rounded-full">
                            <i class="fa-brands fa-whatsapp text-white"></i>
                        </span>
                    </a>
                </div>
            ))}
        </div>
    </div>
</section>