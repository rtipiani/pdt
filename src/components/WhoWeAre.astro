---
interface Props {
    i18n: {
        whoWeAre: {
            title: string;
            paragraphs: string[];
            mision: {
                label: string;
                text: string;
            };
            vision: {
                label: string;
                text: string;
            };
            stats: {
                years: string;
                commitment: string;
                travelers: string;
                travelersSub: string;
            };
        };
    };
}

const { i18n } = Astro.props;
---
<section class="bg-white py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
        <!-- Título Centrado -->
        <div class="mb-12">
            <span class="text-red-700 font-bold uppercase tracking-wider text-sm mb-2 block">
                EST. 2014
            </span>
            <h2 class="text-4xl lg:text-5xl font-extrabold text-gray-950 leading-tight">
                {i18n.whoWeAre.title}
            </h2>
            <div class="w-16 h-2 bg-red-700 mt-6 mx-auto rounded-full"></div>
        </div>

        <!-- Contenido de párrafos -->
        <div class="space-y-6 mb-12 px-2">
            {i18n.whoWeAre.paragraphs.map((paragraph, index) => (
                <p class={`text-gray-900 leading-relaxed text-center ${index === 0 ? 'text-lg md:text-xl font-medium' : 'text-base md:text-lg'}`}>
                    {paragraph}
                </p>
            ))}
        </div>

        <!-- Bloques de Misión y Visión -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
            <div class="bg-gray-50 p-8 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="w-12 h-12 bg-red-700 rounded-full flex items-center justify-center mb-6 mx-auto">
                    <i class="fa-solid fa-bullseye text-white text-xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-950 mb-4">{i18n.whoWeAre.mision.label}</h3>
                <p class="text-gray-900 text-sm leading-relaxed text-center">
                    {i18n.whoWeAre.mision.text}
                </p>
            </div>
            <div class="bg-gray-50 p-8 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="w-12 h-12 bg-red-700 rounded-full flex items-center justify-center mb-6 mx-auto">
                    <i class="fa-solid fa-mountain-sun text-white text-xl"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-950 mb-4">{i18n.whoWeAre.vision.label}</h3>
                <p class="text-gray-900 text-sm leading-relaxed text-center">
                    {i18n.whoWeAre.vision.text}
                </p>
            </div>
        </div>
        
        <!-- Estadísticas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-lg border-t-4 border-red-700 shadow-sm">
                <p class="text-3xl font-bold text-gray-950">+10</p>
                <p class="text-gray-600 text-xs uppercase font-semibold">{i18n.whoWeAre.stats.years}</p>
            </div>
            <div class="bg-white p-6 rounded-lg border-t-4 border-red-700 shadow-sm">
                <p class="text-3xl font-bold text-gray-950">100%</p>
                <p class="text-gray-600 text-xs uppercase font-semibold">{i18n.whoWeAre.stats.commitment}</p>
            </div>
            <div class="bg-white p-6 rounded-lg border-t-4 border-red-700 shadow-sm">
                <p class="text-3xl font-bold text-gray-950">{i18n.whoWeAre.stats.travelers}</p>
                <p class="text-gray-600 text-xs uppercase font-semibold">{i18n.whoWeAre.stats.travelersSub}</p>
            </div>
        </div>
    </div>
</section>
