---
import Layout from '../../layouts/Layout.astro';
import Slider from '../../components/Slider.astro';
import slidesText from '../../i18n/en.json';
import PackagesSection from '../../components/Packages.astro';
import About from '../../components/About.astro';
import WhoWeAre from '../../components/WhoWeAre.astro';
---
<Layout
    title="PDT Peruvian Travel | Travel Agency in Peru - Authentic Tours"
    description="Discover Peru with PDT Peruvian Travel. Customized tours to Cusco, Machu Picchu, Arequipa, Puno and more. Authentic experiences with expert local guides. Book now!"
    preloadImage="/slide1.avif"
>
    <Slider slidesText={slidesText.slides} />
    <WhoWeAre i18n={slidesText} />
    <PackagesSection packagesSection={slidesText.packagesSection} />
    <About i18n={slidesText} />
</Layout>