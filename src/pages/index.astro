---
export const prerender = true;

const { 
  	title = 'PDT Peruvian Travel | Agencia de viajes en Perú', 
  	description = 'Disfruta experiencias auténticas en Perú y Latinoamérica con PDT Peruvian Travel...' 
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  	<head>
    	<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="Rubén Tipiani" />

		<!-- Canonical -->
		<link rel="canonical" href="https://www.pdtperuviantravel.com.pe/" />

		<meta http-equiv="refresh" content="8; URL=/es/" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://www.pdtperuviantravel.com.pe/og-image.avif" />
		<meta property="og:image" content="https://www.pdtperuviantravel.com.pe/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content="https://www.pdtperuviantravel.com.pe/" />
		<meta property="og:site_name" content="PDT Peruvian Travel" />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:locale:alternate" content="en_US" />
		<meta property="og:locale:alternate" content="es_ES" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://www.pdtperuviantravel.com.pe/og-image.avif" />
		<meta name="twitter:image" content="https://www.pdtperuviantravel.com.pe/og-image.png" />
		<meta name="twitter:site" content="@pdtperuviantravel" />
		<meta name="twitter:creator" content="@pdtperuviantravel" />

		<!-- Icons & manifest -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.avif" />
		<link rel="icon" type="image/avif" sizes="32x32" href="/favicon-32x32.avif" />
		<link rel="icon" type="image/avif" sizes="16x16" href="/favicon-16x16.avif" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Hreflangs -->
		<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/" hreflang="es" />
		<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/en/" hreflang="en" />
		<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/" hreflang="x-default" />
		
		<meta property="google-site-verification" content="BumbWo4IzqezJJkny6u1VE8uwX-2_hKVWLQsQSCZ4u8" />
  	</head>
  	<body>
    	<main>
			<h1>Redirigiendo a la nueva página principal</h1>
			<p>
			Estás siendo redirigido a <a href="/es/">/es/</a>. <br />
			Si no ocurre automáticamente, haz clic en el enlace.
			</p>
		</main>
  	</body>
</html>