---
export const prerender = false;

const pathname = Astro.url.pathname;
const currentLocale = pathname.startsWith('/en') ? 'en' : 'es';

const content = {
  es: {
    title: 'PDT Peruvian Travel | Agencia de viajes en Perú',
    description: 'Disfruta experiencias auténticas en Perú y Latinoamérica con PDT Peruvian Travel...',
    redirectUrl: '/es/',
    heading: 'Redirigiéndote a la página principal',
    paragraph: 'Serás redirigido a',
    fallbackText: 'Si no ocurre automáticamente, haz clic en el enlace.',
    loading: 'Cargando...'
  },
  en: {
    title: 'PDT Peruvian Travel | Travel Agency in Peru',
    description: 'Enjoy authentic experiences in Peru and Latin America with PDT Peruvian Travel...',
    redirectUrl: '/en/',
    heading: 'Redirecting to the main page',
    paragraph: 'You will be redirected to',
    fallbackText: 'If it doesn’t happen automatically, click the link.',
    loading: 'Loading...'
  }
};

const {
  title,
  description,
  redirectUrl,
  heading,
  paragraph,
  fallbackText,
  loading
} = content[currentLocale];
---
<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Meta SEO y Open Graph -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Rubén Tipiani" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.pdtperuviantravel.com.pe/og-image.avif" />
    <meta property="og:url" content="https://www.pdtperuviantravel.com.pe/" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/avif" sizes="32x32" href="/favicon-32x32.avif" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" href="https://www.pdtperuviantravel.com.pe/" hreflang="es" />
    <link rel="alternate" href="https://www.pdtperuviantravel.com.pe/en/" hreflang="en" />
    <meta property="google-site-verification" content="BumbWo4IzqezJJkny6u1VE8uwX-2_hKVWLQsQSCZ4u8" />

    <style>
      body {
        margin: 0;
        padding: 0;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1e1e1e;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #f0f0f0;
        text-align: center;
      }

      main {
        background-color: rgba(0, 0, 0, 0.6);
        padding: 2rem 3rem;
        border-radius: 12px;
        box-shadow: 0 0 20px rgba(0,0,0,0.4);
        max-width: 480px;
      }

      h1 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
      }

      p {
        font-size: 1rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
      }

      a {
        color: #ffd700;
        text-decoration: underline;
      }

      .spinner {
        width: 42px;
        height: 42px;
        margin: 0 auto;
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-top-color: #ffd700;
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>

    <script>
      // Redirigir luego de 8 segundos manualmente
      setTimeout(() => {
        window.location.href = "{redirectUrl}";
      }, 8000);
    </script>
  </head>
  <body>
    <main>
      <h1>{heading}</h1>
      <p>{paragraph} <a href={redirectUrl}>{redirectUrl}</a>.<br />{fallbackText}</p>
      <div class="spinner" role="status" aria-label={loading}></div>
    </main>
  </body>
</html>
