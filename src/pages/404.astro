---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="404 - Página no encontrada | Page Not Found" 
    description="Explora los mejores destinos de Perú con PDT Peruvian Travel."
>
    <!-- Fuentes modernas -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500;800&display=swap" rel="stylesheet">

    <main class="relative min-h-screen flex items-center justify-center pt-24 pb-12 overflow-hidden bg-gray-950">
        <!-- Fondo Majestuoso Nítido -->
        <div class="absolute inset-0 z-0">
            <img 
                src="/slide1.avif" 
                alt="Machu Picchu" 
                width="1920"
                height="1080"
                class="w-full h-full object-cover opacity-60"
            />
            <!-- Degradado lateral para profundidad profesional -->
            <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/40 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-transparent to-transparent"></div>
        </div>

        <!-- Contenedor Minimalista -->
        <div class="relative z-10 container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <!-- Columna Izquierda: El Número -->
            <div class="flex justify-center lg:justify-end lg:pr-12">
                <h1 class="outfit font-extrabold text-[150px] md:text-[220px] leading-none text-transparent bg-clip-text bg-gradient-to-b from-yellow-300 to-yellow-600 drop-shadow-[0_10px_30px_rgba(234,179,8,0.3)] animate-subtle-pulse">
                    404
                </h1>
            </div>

            <!-- Columna Derecha: El Mensaje -->
            <div class="text-center lg:text-left max-w-xl space-y-8">
                <div class="space-y-4">
                    <h2 class="outfit text-4xl md:text-5xl font-bold text-white tracking-tight">
                        Ruta no encontrada
                        <span class="block text-xl md:text-2xl font-light text-gray-400 mt-2 italic">Route not found</span>
                    </h2>
                    <p class="outfit text-lg md:text-xl text-gray-300 font-light leading-relaxed">
                        Parece que has llegado a un territorio aún no explorado. <br class="hidden md:block" />
                        Acompañanos de vuelta a nuestro centro de expediciones.
                        <span class="block text-gray-400 text-sm mt-2 font-normal italic">It seems you've reached an unexplored territory. Let's head back home.</span>
                    </p>
                </div>

                <!-- Botones de Acción Estilo Corporativo -->
                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <a 
                        href="/es/" 
                        class="outfit px-8 py-4 bg-yellow-500 hover:bg-yellow-400 text-gray-950 font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2 shadow-lg shadow-yellow-500/20"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        Inicio (ES)
                    </a>
                    <a 
                        href="/en/" 
                        class="outfit px-8 py-4 bg-transparent border-2 border-white/20 hover:border-white/60 text-white font-bold rounded-xl transition-all duration-300 flex items-center justify-center gap-2"
                    >
                        Home (EN)
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </a>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .outfit { font-family: 'Outfit', sans-serif; }

    @keyframes subtlePulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.9; transform: scale(1.02); }
    }

    .animate-subtle-pulse {
        animation: subtlePulse 4s ease-in-out infinite;
    }

    /* Ajustes específicos para móviles */
    @media (max-width: 1024px) {
        h1 { margin-bottom: -2rem; }
    }
</style>
