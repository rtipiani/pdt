---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { routeMap } from '../utils/routes';

import es from '../i18n/es.json';
import en from '../i18n/en.json';

import faBrands from '@fortawesome/fontawesome-free/webfonts/fa-brands-400.woff2?url';
import faSolid from '@fortawesome/fontawesome-free/webfonts/fa-solid-900.woff2?url';

const pathname = Astro.url.pathname;
const currentLocale = pathname.startsWith('/en') ? 'en' : 'es';
const i18nData = currentLocale === 'en' ? en : es;

const {
  	title = 'PDT Peruvian Travel | Agencia de viajes en Perú',
  	description = 'Disfruta experiencias auténticas en Perú y Latinoamérica con PDT Peruvian Travel...',
    preloadImage = null
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/og-image.png', Astro.site).toString();
const logoUrl = new URL('/android-chrome-512x512.avif', Astro.site).toString();

const cleanPath = pathname.toLowerCase().replace(/\/$/, '');
const esPath = currentLocale === 'en' ? (routeMap[cleanPath] || '/') : (cleanPath || '/');
const enPath = currentLocale === 'es' ? (routeMap[cleanPath] || '/en/') : (cleanPath || '/en/');

const alternateEsUrl = new URL(esPath, Astro.site).toString();
const alternateEnUrl = new URL(enPath, Astro.site).toString();

const message = currentLocale === 'en'
  	? "Hello, I’m interested in learning more about your tour packages."
  	: "Hola, estoy interesado en conocer más sobre sus paquetes turísticos.";

const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/51980852997?text=${encodedMessage}`;

const tooltipText = currentLocale === 'en'
  	? "Need help? Message us!"
  	: "¿Tienes dudas? ¡Escríbenos!";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": "PDT Peruvian Travel",
  "description": currentLocale === 'en' 
    ? "Enjoy authentic experiences in Peru and Latin America with PDT Peruvian Travel"
    : "Disfruta experiencias auténticas en Perú y Latinoamérica con PDT Peruvian Travel",
  "url": Astro.site,
  "logo": logoUrl,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+51-980-852-997",
    "contactType": "customer service",
    "availableLanguage": ["Spanish", "English"]
  },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "PE"
  },
  "sameAs": [
    "https://www.facebook.com/pdtperuviantravel",
    "https://www.instagram.com/pdtperuviantravel"
  ]
};
---
<!doctype html>
<html lang={currentLocale} dir="ltr">
  	<head>
    	<meta charset="UTF-8" />
    	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    	<title>{title}</title>
    	<meta name="description" content={description} />
    	<meta name="robots" content="index, follow" />
    	<meta name="author" content="Rubén Tipiani" />

    	<!-- Canonical -->
    	<link rel="canonical" href={currentUrl} />

    	<!-- Open Graph -->
    	<meta property="og:type" content="website" />
    	<meta property="og:title" content={title} />
    	<meta property="og:description" content={description} />
    	<meta property="og:image" content={ogImageUrl} />
    	<meta property="og:image:type" content="image/png" />
    	<meta property="og:image:width" content="1200" />
    	<meta property="og:image:height" content="630" />
    	<meta property="og:url" content={currentUrl} />
    	<meta property="og:site_name" content="PDT Peruvian Travel" />
    	<meta property="og:locale" content={currentLocale === 'en' ? 'en_US' : 'es_PE'} />
    	<meta property="og:locale:alternate" content="en_US" />
    	<meta property="og:locale:alternate" content="es_ES" />

    	<!-- Twitter Card -->
    	<meta name="twitter:card" content="summary_large_image" />
    	<meta name="twitter:title" content={title} />
    	<meta name="twitter:description" content={description} />
    	<meta name="twitter:image" content={ogImageUrl} />
    	<meta name="twitter:site" content="@pdtperuviantravel" />
    	<meta name="twitter:creator" content="@pdtperuviantravel" />

    	<!-- Structured Data -->
    	<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    	<!-- Icons & manifest -->
    	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.avif" />
    	<link rel="icon" type="image/avif" sizes="32x32" href="/favicon-32x32.avif" />
    	<link rel="icon" type="image/avif" sizes="16x16" href="/favicon-16x16.avif" />
    	<link rel="manifest" href="/site.webmanifest" />

    	<!-- Hreflangs -->
    	<link rel="alternate" href={alternateEsUrl} hreflang="es" />
    	<link rel="alternate" href={alternateEnUrl} hreflang="en" />
    	<link rel="alternate" href={alternateEsUrl} hreflang="x-default" />

        <!-- LCP Preload -->
        {preloadImage && (
            <link 
                rel="preload" 
                as="image" 
                href={preloadImage} 
                imagesrcset={`
                    ${preloadImage.replace('.avif', '-355w.avif')} 355w,
                    ${preloadImage.replace('.avif', '-600w.avif')} 600w,
                    ${preloadImage.replace('.avif', '-852w.avif')} 852w,
                    ${preloadImage.replace('.avif', '-1278w.avif')} 1278w,
                    ${preloadImage.replace('.avif', '-1680w.avif')} 1680w,
                    ${preloadImage.replace('.avif', '-2000w.avif')} 2000w,
                    ${preloadImage.replace('.avif', '-2268w.avif')} 2268w
                `}
                imagesizes={`
                    (min-width: 2268px) 2268px,
                    (min-width: 2000px) 2000px,
                    (min-width: 1680px) 1680px,
                    (min-width: 1278px) 1278px,
                    (min-width: 852px) 852px,
                    (min-width: 600px) 600px,
                    (min-width: 355px) 355px,
                    100vw
                `}
                fetchpriority="high" 
            />
        )}

        <!-- Font Preloads -->
        <link rel="preload" href={faBrands} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={faSolid} as="font" type="font/woff2" crossorigin />

        <style is:inline define:vars={{ faBrands, faSolid }}>
            @font-face {
                font-family: 'Font Awesome 6 Brands';
                font-style: normal;
                font-weight: 400;
                font-display: swap;
                src: url(var(--faBrands)) format('woff2');
            }
            @font-face {
                font-family: 'Font Awesome 6 Free';
                font-style: normal;
                font-weight: 900;
                font-display: swap;
                src: url(var(--faSolid)) format('woff2');
            }
        </style>

    	<meta name="google-site-verification" content="BumbWo4IzqezJJkny6u1VE8uwX-2_hKVWLQsQSCZ4u8" />
  	</head>

  	<body>
    	<Header />
    	<slot />
    	<Footer i18n={{ footer: i18nData.footer }} />

    	<div class="group fixed bottom-6 right-6 z-50 flex items-center space-x-2">
      		<div class="relative mr-3 hidden sm:block">
        		<div class="absolute right-full top-1/2 transform -translate-y-1/2 translate-x-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-md opacity-0 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out whitespace-nowrap">
          			{tooltipText}
          			<div class="absolute top-1/2 left-full transform -translate-y-1/2 -ml-px w-0 h-0 border-t-6 border-b-6 border-l-6 border-transparent border-l-gray-800"></div>
        		</div>
      		</div>

      		<a href={whatsappUrl} class="bg-green-500 hover:bg-green-600 text-white w-14 h-14 flex items-center justify-center rounded-full shadow-lg transition-transform hover:scale-110 animate-vibrate-once" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
        		<i class="fab fa-whatsapp text-2xl"></i>
      		</a>
    	</div>
  	</body>
</html>