---
import "../styles/global.css";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pathname = Astro.url.pathname;
const currentLocale = pathname.startsWith('/en') ? 'en' : 'es';
const i18nData = await import(`../i18n/${currentLocale}.json`);

const {
  	title = 'PDT Peruvian Travel | Agencia de viajes en Perú',
  	description = 'Disfruta experiencias auténticas en Perú y Latinoamérica con PDT Peruvian Travel...'
} = Astro.props;

const message = currentLocale === 'en'
  	? "Hello, I’m interested in learning more about your tour packages."
  	: "Hola, estoy interesado en conocer más sobre sus paquetes turísticos.";

const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/51980852997?text=${encodedMessage}`;

const tooltipText = currentLocale === 'en'
  	? "Need help? Message us!"
  	: "¿Tienes dudas? ¡Escríbenos!";
---
<!doctype html>
<html lang={currentLocale} dir="ltr">
  	<head>
    	<meta charset="UTF-8" />
    	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    	<title>{title}</title>
    	<meta name="description" content={description} />
    	<meta name="robots" content="index, follow" />
    	<meta name="author" content="Rubén Tipiani" />

    	<!-- Canonical -->
    	<link rel="canonical" href="https://www.pdtperuviantravel.com.pe/" />

    	<!-- Open Graph -->
    	<meta property="og:type" content="website" />
    	<meta property="og:title" content={title} />
    	<meta property="og:description" content={description} />
    	<meta property="og:image" content="https://www.pdtperuviantravel.com.pe/og-image.avif" />
    	<meta property="og:image" content="https://www.pdtperuviantravel.com.pe/og-image.png" />
    	<meta property="og:image:width" content="1200" />
    	<meta property="og:image:height" content="630" />
    	<meta property="og:url" content="https://www.pdtperuviantravel.com.pe/" />
    	<meta property="og:site_name" content="PDT Peruvian Travel" />
    	<meta property="og:locale" content="es_PE" />
    	<meta property="og:locale:alternate" content="en_US" />
    	<meta property="og:locale:alternate" content="es_ES" />

    	<!-- Twitter Card -->
    	<meta name="twitter:card" content="summary_large_image" />
    	<meta name="twitter:title" content={title} />
    	<meta name="twitter:description" content={description} />
    	<meta name="twitter:image" content="https://www.pdtperuviantravel.com.pe/og-image.avif" />
    	<meta name="twitter:image" content="https://www.pdtperuviantravel.com.pe/og-image.png" />
    	<meta name="twitter:site" content="@pdtperuviantravel" />
    	<meta name="twitter:creator" content="@pdtperuviantravel" />

    	<!-- Icons & manifest -->
    	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.avif" />
    	<link rel="icon" type="image/avif" sizes="32x32" href="/favicon-32x32.avif" />
    	<link rel="icon" type="image/avif" sizes="16x16" href="/favicon-16x16.avif" />
    	<link rel="manifest" href="/site.webmanifest" />

    	<!-- Hreflangs -->
    	<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/" hreflang="es" />
    	<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/en/" hreflang="en" />
    	<link rel="alternate" href="https://www.pdtperuviantravel.com.pe/" hreflang="x-default" />

    	<meta name="google-site-verification" content="BumbWo4IzqezJJkny6u1VE8uwX-2_hKVWLQsQSCZ4u8" />
  	</head>

  	<body>
    	<Header />
    	<slot />
    	<Footer i18n={{ footer: i18nData.default.footer }} />

    	<div class="group fixed bottom-6 right-6 z-50 flex items-center space-x-2">
      		<div class="relative mr-3 hidden sm:block">
        		<div class="absolute right-full top-1/2 transform -translate-y-1/2 translate-x-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-md opacity-0 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out whitespace-nowrap">
          			{tooltipText}
          			<div class="absolute top-1/2 left-full transform -translate-y-1/2 -ml-px w-0 h-0 border-t-6 border-b-6 border-l-6 border-transparent border-l-gray-800"></div>
        		</div>
      		</div>

      		<a href={whatsappUrl} class="bg-green-500 hover:bg-green-600 text-white w-14 h-14 flex items-center justify-center rounded-full shadow-lg transition-transform hover:scale-110 animate-vibrate-once" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
        		<i class="fab fa-whatsapp text-2xl"></i>
      		</a>
    	</div>
  	</body>
</html>